# Gemini API key for /api/chat (server-side only).
# Local dev: copy this file to .env.local and fill in your key.
# Production (Vercel): set this in Project Settings → Environment Variables.
GEMINI_API_KEY=

# OpenAI API key for /api/generate-look (server-side only).
# Powers gpt-image-2 look generation: first look via generations endpoint,
# subsequent look changes via edits endpoint (previous look's neutral as reference).
# OPTIONAL — if not set, /api/generate-look returns 503 (code: NO_IMAGE_API)
# and the game continues in "formless" mode (silhouette display) without crashing.
#
# COST SAFETY: image generation is metered (gpt-image-2 ~$0.005-0.165/image) and
# these routes are unauthenticated. Set a HARD monthly budget limit on the OpenAI
# project (platform.openai.com -> Settings -> Limits) so a public Preview URL can
# never run up an unbounded bill. Use a separate, low-budget key for Preview.
OPENAI_API_KEY=

# --- Supabase (OPTIONAL backend) ---------------------------------------------
# When set, generated look images are uploaded to Supabase Storage and served by
# URL (立ち絵 persist across reloads; localStorage stays small). Without these,
# the app falls back to inline data URLs and localStorage as before.
# Get these from: Supabase Dashboard -> Project Settings -> API.
# URL + anon key are public (safe in the browser via NEXT_PUBLIC_, protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key is SECRET (server-side only, bypasses RLS). Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
